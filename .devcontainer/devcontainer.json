{
    "name": "pv-simulator-dev",
    "dockerComposeFile": [
        "compose.yml"
    ],
    "service": "pv-simulator",
    "workspaceFolder": "/workspace",
    "mounts": [
        "source=/users/milosznowak/repos/nexus-json-templates,target=/mnt/templates,type=bind,consistency=cached",
        "source=${localWorkspaceFolder}/output,target=/mnt/output,type=bind"
    ],
    "postCreateCommand": "pip install --no-cache-dir -r requirements.txt",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-azuretools.vscode-docker"
            ],
            "settings": {
                "terminal.integrated.shell.linux": "/bin/bash"
            }
        }
    }
}
